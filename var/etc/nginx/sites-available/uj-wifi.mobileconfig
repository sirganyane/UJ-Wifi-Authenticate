server {
    listen 80;
    server_name wifi.uj.ac.za;
    return 301 https://$server_name$request_uri; # Force HTTPS
}

server {
    listen 443 ssl;
    server_name wifi.uj.ac.za;

    ssl_certificate /etc/letsencrypt/live/wifi.uj.ac.za/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wifi.uj.ac.za/privkey.pem;

    root /var/www/uj-wifi/public;
    index index.php index.html;

    # Handle the .mobileconfig MIME type
    location /profiles/ {
        alias /var/www/uj-wifi/profiles/;
        types {
            application/x-apple-aspen-config mobileconfig;
        }
        add_header Content-Disposition "attachment";
    }

    # Serve the Root CA and CRL
    location /certs/ {
        alias /var/www/uj-wifi/certs/;
        default_type application/x-x509-ca-cert;
    }

    # PHP-FPM for the API and Detection logic
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock; # Adjust version as needed
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # Security: Deny access to .key files
    location ~ \.key$ {
        deny all;
    }
}